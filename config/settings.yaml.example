# Squelch configuration — copy to config/settings.yaml and edit

server:
  host: "0.0.0.0"
  port: 8000

sdr:
  # RTL-SDR device index (0 = first dongle)
  device_index: 0
  # AGC enabled by default; set to a number (0-50) to override with manual gain
  gain: "auto"
  # PPM frequency correction for your specific dongle (run rtl_test -p to find yours)
  ppm_correction: 0
  # De-emphasis time constant: 75 (USA/South Korea) or 50 (Europe/Australia)
  deemphasis_us: 75

recordings:
  # Directory where recordings are saved
  output_dir: "~/recordings"

# Icecast2 secondary output (optional — requires a running Icecast server;
# see config/icecast.xml.example). Pushes the same AAC stream to an Icecast
# mount and updates now-playing metadata from RDS/HD Radio.
icecast:
  enabled: false
  host: "localhost"
  port: 8001
  source_password: "changeme"
  mount: "/radio"
  # false (default): connect only while someone is listening or recording,
  #   preserving DSP idle-suspend — the mount disappears while Squelch is idle.
  # true: keep the mount live whenever a station is tuned; the Pi runs the
  #   DSP continuously even with no listeners (more CPU/heat).
  keep_alive: false

# Default station presets loaded on first run (can be edited in the UI)
default_presets:
  - name: "Example FM"
    frequency: 91.1
    band: "fm"
  - name: "Example AM"
    frequency: 1000
    band: "am"
